rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // For this custom POS/Lounge app using custom username/password auth
      // we allow read/write. In a real production scenario with Firebase Auth, 
      // this should be restricted.
      allow read, write: if true;
    }
  }
}
